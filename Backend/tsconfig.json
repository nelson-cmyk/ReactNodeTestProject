{
  "compilerOptions": {
    "target": "ES6",
    "module": "CommonJS",
    "moduleResolution": "Node",

    "rootDir": "..",
    "outDir": "./dist",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
    
  },
  "include": ["src/**/*.ts",
    "src/**/*.d.ts",
    "../shared/**/*.ts"

]
}
